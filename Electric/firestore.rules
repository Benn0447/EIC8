rules_version = '2';

// ============================================================
//  Firestore Security Rules — EIC8 Check Sheet (cloned system)
//
//  Trust model matches the original project: there is NO real
//  per-request authentication anywhere in this app (login is a
//  pure client-side check against the `dashboard_users`
//  collection). Every collection this app touches is fully open.
//  Rules are collection-allowlisted on purpose — a NEW collection
//  with no matching `match` block is DENIED by default, so if you
//  add a feature that writes a new collection, add its block here.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Main check sheet submissions (append-only in practice)
    match /checksheets/{doc} {
      allow read, write: if true;
    }

    // Review / approval workflow records (mutated in place)
    match /approvals/{doc} {
      allow read, write: if true;
    }

    // Dashboard + technician login accounts, self-registration
    match /dashboard_users/{doc} {
      allow read, write: if true;
    }

    // Runtime config (e.g. dashboard_config/registration.code)
    match /dashboard_config/{doc} {
      allow read, write: if true;
    }

    // Weekly Report Dashboard — meta doc + its workOrders subcollection
    match /weekly_dashboard/{doc} {
      allow read, write: if true;
      match /{sub=**} {
        allow read, write: if true;
      }
    }

    // ── Instrument department (migrated off Supabase) ──
    // Same fully-open trust model as above, by explicit user decision —
    // Supabase enforced workflow-state transitions via real Postgres RLS;
    // this intentionally does not replicate that at the DB layer, matching
    // Electric's own app-layer-only gating instead.

    // pm_records: draft + workflow-state doc per Instrument check sheet
    // submission (mutable in place — NOT the same shape as /checksheets,
    // which is append-only/immutable; do not merge these two collections).
    match /pm_records/{doc} {
      allow read, write: if true;
    }

    // Gate Akses — trusted-device allowlist + gate password/config
    match /trusted_devices/{doc} {
      allow read, write: if true;
    }
    match /gate_config/{doc} {
      allow read, write: if true;
    }

    // Report-auth profiles (checker/reviewer/SPV), keyed by Firebase Auth UID
    match /pm_profiles/{doc} {
      allow read, write: if true;
    }

    // Approver signature images (PNG data-URL), doc id = slug(display name)
    match /pm_signatures/{doc} {
      allow read, write: if true;
    }

    // Outage module (password-gated MOD-14)
    match /outage_assets/{doc} {
      allow read, write: if true;
    }
    match /outage_records/{doc} {
      allow read, write: if true;
    }

    // Standalone Instrument modules with their own inline Supabase client
    match /ts_checksheet/{doc} {
      allow read, write: if true;
    }
    match /material_warehouse/{doc} {
      allow read, write: if true;
    }
    match /material_jenis/{doc} {
      allow read, write: if true;
    }
    match /material_pengambilan/{doc} {
      allow read, write: if true;
    }
  }
}
